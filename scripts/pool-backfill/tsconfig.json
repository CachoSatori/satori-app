// Typecheck del harness de backfill. NO entra a `npm run build` (el tsconfig raíz tiene
// files: [] y solo referencia tsconfig.app.json / tsconfig.node.json), así que es inerte
// para el build de la app:
//
//   npx tsc -p scripts/pool-backfill
//
// `moduleResolution: bundler` es a propósito: iguala a tsconfig.app.json y resuelve los
// imports sin extensión de src/ (que Vite resuelve y `nodenext` no). En runtime ese mismo
// hueco lo tapa ts-resolve-hook.mjs. Mismo molde que scripts/t0-reconciliacion-cajas.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["*.ts"]
}
