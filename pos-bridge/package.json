{
  "name": "pos-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Extractor local READ-ONLY del PoS \"Nube de Fuego\" (SQL Server, base ndf) → forma DiaData. Fase 1a: dry-run para cuadrar un día contra el Excel. Cero escritura.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dia": "node --import ./register.mjs dia.ts",
    "agente": "node --import ./register.mjs agente.ts",
    "backfill": "node --import ./register.mjs backfill.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "mssql": "^12.7.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.12.3",
    "typescript": "~6.0.2"
  }
}
