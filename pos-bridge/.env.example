# ── pos-bridge · conexión de SOLO LECTURA al PoS "Nube de Fuego" ──────────────
# Copiar a `.env` (que está en .gitignore) y completar SOLO en la PC del PoS.
# La contraseña no se manda por WhatsApp ni por mail, y no va al repositorio.

# Servidor. Si se deja POS_DB_PORT, manda el puerto y la instancia se ignora
# (tedious no acepta los dos). Para descubrir la instancia por el SQL Browser,
# dejar POS_DB_PORT vacío y poner el host con la instancia: DESKTOP-25PRDR1\SQLNUBE
POS_DB_HOST=DESKTOP-25PRDR1\SQLNUBE
POS_DB_PORT=1433
POS_DB_DATABASE=ndf

# Usuario de SOLO LECTURA (db_datareader). El admin del PoS NO se usa jamás:
# el bridge aborta si acá aparece un usuario administrativo.
POS_DB_USER=ClienteConsulta
POS_DB_PASSWORD=

# Instalación local: sin TLS y con certificado autofirmado.
POS_DB_ENCRYPT=false
POS_DB_TRUST_CERT=true

# Timeouts (ms). Subir el de request si el día tiene mucho detalle.
# POS_DB_CONNECT_TIMEOUT_MS=15000
# POS_DB_REQUEST_TIMEOUT_MS=60000

# Overrides de nombres de columna, SOLO si el extractor avisa que no encontró uno.
# Formato: POS_COL_<TABLA>_<CAMPO>=<NombreReal>
# POS_COL_FACTURASDET_MONTO=MontoTotal
# POS_COL_PRODUCTOS_CLASIFICACION=CodigoClasificacion
