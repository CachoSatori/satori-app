# ── Agente PoS · plantilla de configuración ─────────────────────────────────────
# Copiar a `.env` y completar EN LA PC DEL LOCAL. El .env nunca va al repo
# (está en el .gitignore) y nunca se manda por WhatsApp ni por mail.
#
# ⚠ ACÁ NO HAY CREDENCIALES REALES. Los valores son placeholders.

LOCAL=santa-teresa            # o nosara — UNA PC por local

# ── SQL Server del PoS ──────────────────────────────────────────────────────────
POS_HOST=127.0.0.1
POS_PORT=1433
POS_DB=ndf
POS_USER=satori_ro            # usuario de SOLO LECTURA, a crear por el proveedor del PoS
POS_PASSWORD=                 # ← completar en la PC

# `true` si la instancia usa certificado autofirmado (lo normal en una PC de local).
POS_TRUST_SERVER_CERT=true

# ── Destino ─────────────────────────────────────────────────────────────────────
# ⚠ TBD: la Edge Function todavía NO existe (Fase B).
INGEST_URL=https://TBD.supabase.co/functions/v1/ingest-ventas
INGEST_SECRET=                # ← completar en la PC

POLL_INTERVAL_MS=120000
BATCH_SIZE=200
STATE_FILE=./.bridge-state.json
